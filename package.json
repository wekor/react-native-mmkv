{
  "name": "@wekor/react-native-mmkv",
  "version": "3.4.0",
  "description": "A maintained fork of react-native-mmkv 3.x for current React Native and Expo. The fastest key/value storage for React Native.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "cpp/**/*.h",
    "cpp/**/*.cpp",
    "MMKV/Core",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "ios/**/*.h",
    "ios/**/*.mm",
    "*.podspec",
    "react-native.config.js",
    "!android/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun run --cwd example",
    "check": "biome check",
    "fix": "biome check --write",
    "format": "biome format --write",
    "format:cpp": "scripts/clang-format.sh",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc && tsc -p tsconfig.test.json && tsc -p example",
    "build:android:prepare": "bun run example expo prebuild --platform android --no-install",
    "build:android": "./example/android/gradlew --project-dir example/android :app:assembleDebug",
    "build:ios:prepare": "bun run example expo prebuild --platform ios",
    "build:ios": "xcodebuild -workspace example/ios/MMKVExample.xcworkspace -scheme MMKVExample -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build -quiet",
    "test": "bun test src"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "mmkv",
    "storage",
    "key",
    "value",
    "fast",
    "turbo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wekor/react-native-mmkv.git"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "contributors": [
    "wekor"
  ],
  "license": "(MIT AND BSD-3-Clause)",
  "bugs": {
    "url": "https://github.com/wekor/react-native-mmkv/issues"
  },
  "homepage": "https://github.com/wekor/react-native-mmkv#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@happy-dom/global-registrator": "^20.0.0",
    "@react-native/babel-preset": "0.88.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.4.4",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNMmkvSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.mrousavy.mmkv"
    }
  }
}
